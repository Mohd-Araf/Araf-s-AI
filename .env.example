# Environment Variables Example for Araf's Assistant

# Django Settings
SECRET_KEY=django-insecure-arafs-assistant-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Leave blank for default SQLite, or provide PostgreSQL URL)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/arafs_assistant_db
DATABASE_URL=

# AI Provider Keys
# Google Gemini API Key (Recommended - get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Default Model Selection: "gemini-2.5-flash", "gemini-1.5-flash", "gpt-4o-mini", "gpt-3.5-turbo"
AI_DEFAULT_MODEL=gemini-2.5-flash

# Web Search Settings (DuckDuckGo is free & built-in)
ENABLE_WEB_SEARCH=True
MAX_SEARCH_RESULTS=4
